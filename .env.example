# Build-time only. Default: email preparation; visitor sends from their own mail app.
QUOTE_TRANSPORT=email
QUOTE_ENDPOINT=/api/quote.php
# The optional PHP server reads QUOTE_ENABLED, QUOTE_TO, QUOTE_FROM and QUOTE_CONFIG_FILE
# from the host environment or a private config file OUTSIDE the document root.
# Do not put credentials or enablement files in dist/.
